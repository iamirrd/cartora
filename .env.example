# Copy to .env and replace the secret and database password before starting.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Local PostgreSQL. Docker Compose overrides HOST=db and PORT=5432 in web.
POSTGRES_DB=cartora
POSTGRES_USER=cartora
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Development simulator; always disabled when DJANGO_DEBUG=False.
ENABLE_MOCK_PAYMENTS=True

# Optional Firebase push. In-app notifications work without Firebase.
FIREBASE_ENABLED=False
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-credentials.json
